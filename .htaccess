# InterCare Asia static site - generated redirect rules (replaces WordPress)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

RewriteEngine On

# Old WordPress media -> /media (only when the file exists in /media)
RewriteCond %{DOCUMENT_ROOT}/media/$1 -f
RewriteRule ^wp-content/uploads/(.+)$ /media/$1 [R=301,L]

# WordPress system URLs
RewriteRule ^(wp-admin|wp-login\.php|wp-json|xmlrpc\.php|feed|comments/feed)(/.*)?$ / [R=301,L]
RewriteRule ^th/(feed)(/.*)?$ /th/ [R=301,L]

# Legacy pages and articles
RewriteRule ^th/fact\-sheet/?$ /th/factsheet/ [R=301,L,NE]
RewriteRule ^thankyou/?$ /factsheet/ [R=301,L,NE]
RewriteRule ^why\-visit/?$ / [R=301,L,NE]
